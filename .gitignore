# ==============================================================================
# LazyVault Monorepo .gitignore
# Covers Android (Gradle/Kotlin), Node.js (Broker/Web), Python CLI, & Secrets
# ==============================================================================

# --- Android & Gradle ---
*.apk
*.aab
*.ap_
*.hprof
output-metadata.json
build/
**/build/
android/app/build/
.gradle/
**/.gradle/
.kotlin/
**/.kotlin/
*.iml
.idea/
!.idea/codeStyles/
local.properties
**/local.properties
captures/
.externalNativeBuild/
.cxx/
**/.cxx/

# --- Node.js, TypeScript & Web Frontend ---
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
*.tsbuildinfo
.eslintcache
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Firebase Hosting & Emulators ---
.firebase/
**/.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# --- Backend Ephemeral & Runtime Storage ---
# CRITICAL: Never commit ephemeral client payloads, relays, or runtime data
ephemeral_relay/
**/ephemeral_relay/
backend/data/
*.enc
*.raw
*.tmp
*.temp
tmp/
**/tmp/

# --- Python & CLI / CI Test Artifacts ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
*.egg-info/
.eggs/
.mypy_cache/
.ruff_cache/
cicd_download_*
test_download_*
e2e_output_*

# --- Secrets, Credentials, & Private Keys (NEVER COMMIT) ---
.env
.env.*
!.env.example
serviceAccountKey.json
backend/serviceAccountKey.json
*.keystore
*.jks
*.p8
*.p12
*.pem
*.key

# --- Operating System & Editor Artifacts ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
*.swp
*~
*.log
.vscode/
*.code-workspace
.history/
