{
  "hosting": [
    {
      "site": "lazyvault",
      "public": "web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "lazyvault-node",
      "public": "web/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/v/:vaultId*",
          "destination": "https://lazyvault.web.app/v/:vaultId*",
          "type": 301
        },
        {
          "source": "**",
          "destination": "https://lazyvault.web.app",
          "type": 301
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  }
}
