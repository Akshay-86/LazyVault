# LazyVault Backend Configuration
PORT=4000
NODE_ENV=development

# Optional: Path to Firebase Service Account JSON file for production FCM push triggers
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# Or inline JSON:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Device Auth Token (Optional shared secret)
LAZYVAULT_DEVICE_SECRET=lazyvault_secret_token_change_me
